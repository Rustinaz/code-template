# Editor-agnostic defaults. Every mainstream editor reads this file, so the
# formatting it describes is the same in VS Code, RustRover, Zed, Neovim and
# Android Studio without committing any one editor's project files.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{toml,yaml,yml}]
indent_size = 2

[*.md]
# Trailing spaces are meaningful in Markdown (hard line breaks).
trim_trailing_whitespace = false
